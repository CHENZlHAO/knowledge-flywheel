# Dify self-contained stack settings. Copy to .env and adjust.
DIFY_VERSION=1.12.0
DIFY_IMAGE_PREFIX=docker.m.daocloud.io/langgenius
POSTGRES_VERSION=15-alpine
REDIS_VERSION=6-alpine
DIFY_DB_PASSWORD=change-me-strong-password
DIFY_REDIS_PASSWORD=change-me-redis-password
DIFY_SECRET_KEY=change-me-long-random-secret
# Dify will reach the Hub through these URLs (use the Docker network host).
HUB_INTERNAL_URL=http://host.docker.internal:8000
FLYWHEEL_INGEST_API_KEY=
SEARCH_API_KEY=
DOWNLOAD_API_KEY=
