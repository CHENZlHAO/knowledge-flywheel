APP_ENV=development
EMQX_IMAGE=docker.m.daocloud.io/emqx/emqx:5.8
POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
REDIS_IMAGE=docker.m.daocloud.io/redis:7.4-alpine
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DATABASE_URL=postgresql+psycopg://knowledge:knowledge@postgres:5432/knowledge
REDIS_URL=redis://redis:6379/0
TASK_EXECUTION_MODE=poll
ORCHESTRATION_MODE=state_machine
CELERY_QUEUE=knowledge-tasks
CELERY_HEALTH_TIMEOUT_SECONDS=0.5
MQTT_HOST=emqx
MQTT_PORT=8883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=knowledge-hub-status-bridge
MQTT_PASSWORD=replace-with-strong-bridge-password
MQTT_CA_FILE=/run/mqtt-certs/ca.crt
MQTT_CLIENT_CERT_FILE=/run/mqtt-certs/bridge.crt
MQTT_CLIENT_KEY_FILE=/run/mqtt-certs/bridge.key
MQTT_BRIDGE_API_KEY=replace-with-long-random-bridge-key
HUB_INTERNAL_URL=http://hub:8000
API_HOST=0.0.0.0
API_PORT=8000
NODE_OFFLINE_AFTER_SECONDS=90
FILE_MISSING_AFTER_SECONDS=300
REMOTE_COMMAND_LEASE_SECONDS=120
MAX_UPLOAD_BYTES=52428800
PARSE_CHUNK_CHARS=1000
REPLICA_NODE_IDS=
ADMIN_API_KEY=
NODE_API_KEY=
MOBILE_API_KEY=
SEARCH_API_KEY=
FLYWHEEL_INGEST_API_KEY=
DOWNLOAD_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-large-zh
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_ALLOWED_HOSTS=ollama,localhost,127.0.0.1
MAX_SEARCH_QUERY_CHARS=4000
MAX_SEARCH_TOP_K=20
DSH_ENABLED=false
DSH_BASE_URL=http://deepseek-harness:8010
DSH_API_KEY=
DSH_TIMEOUT_SECONDS=15
DSH_ALLOWED_HOSTS=localhost,127.0.0.1,deepseek-harness
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PREFIX=knowledge-hub
ALERT_CHANNELS=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TLS=true
ALERT_WEBHOOK_URL=
ALERT_WECOM_WEBHOOK=
ALERT_DINGTALK_WEBHOOK=
ALERT_RETRY_MAX=3
ALERT_RETRY_BACKOFF_SECONDS=30
ALERT_SUPPRESS_WINDOW_SECONDS=300
SECURITY_SECRET=
JWT_TTL_SECONDS=3600
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_ISSUER=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
